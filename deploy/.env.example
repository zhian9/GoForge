# ============================================
# GoForge Docker 环境变量
# cp .env.example .env 并根据需要修改
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=go_forge
DB_PASSWORD=123456

# ---------- Redis ----------
REDIS_PASSWORD=123456

# ---------- MongoDB ----------
MONGO_ROOT_PASSWORD=123456
MONGO_URI=mongodb://root:123456@mongodb:27017/?authSource=admin

# ---------- Elasticsearch ----------
ES_PASSWORD=123456

# ---------- JWT ----------
JWT_SECRET=goforge-jwt-secret

# ---------- 镜像标签 ----------
GOFORGE_TAG=latest
